{
  "name": "cpp2rustpal",
  "displayName": "Pal — C++ to Rust",
  "description": "Real-time C++ to Rust concept translator - shows Rust equivalents and syntax hints as you write C++",
  "version": "0.1.0",
  "publisher": "rust-cpp-translator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farhatnadim/cpp2rustpal"
  },
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:cuda-cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cppToRust.refreshHints",
        "title": "C++ to Rust: Refresh Hints"
      },
      {
        "command": "cppToRust.openHints",
        "title": "C++ to Rust: Open Hints"
      },
      {
        "command": "cppToRust.toggleEnabled",
        "title": "C++ to Rust: Toggle Enabled"
      },
      {
        "command": "cppToRust.openCargoProject",
        "title": "C++ to Rust: Open Mirrored Cargo Project"
      }
    ],
    "configuration": {
      "title": "C++ to Rust Translator",
      "properties": {
        "cppToRust.llmEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch. When false, the extension does nothing."
        },
        "cppToRust.llmEndpoint": {
          "type": "string",
          "default": "http://localhost:8001",
          "description": "Base URL of the llama-server OpenAI-compatible API"
        },
        "cppToRust.llmModel": {
          "type": "string",
          "default": "unsloth/Qwen3.5-35B-A3B",
          "description": "Model alias to send in chat completions requests"
        },
        "cppToRust.sideBySide": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the sibling .hints.md beside the C++ file"
        },
        "cppToRust.healthCheckIntervalMs": {
          "type": "number",
          "default": 30000,
          "description": "How often (ms) to poll GET {endpoint}/v1/models while a C++ file is active"
        },
        "cppToRust.cargoMirrorEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Scaffold and maintain a rust_<name>/ Cargo project next to each detected cpp_<name>/"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.76.0",
    "@types/node": "18.x",
    "typescript": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0"
  }
}
